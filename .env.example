# Emergency X — Environment Configuration
# Copy this file to .env and fill in values for your deployment

# Backend
PORT=5000
JWT_SECRET=emergency-x-super-secret-jwt-key-change-in-production
DB_PATH=./emergency_x.db
POLICE_TIMEOUT_SECONDS=30
HOSPITAL_TIMEOUT_SECONDS=45

# Optional: OSRM Routing (uses public demo server by default)
# OSRM_API_URL=https://router.project-osrm.org

# Frontend (Vite prefixed)
VITE_API_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
